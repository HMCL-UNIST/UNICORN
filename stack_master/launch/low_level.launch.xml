<?xml version="1.0"?>
<launch>
  <!-- Arguments -->
  <arg name="sim"            default="false"      description="Use simulator (true) or real hardware (false)"/>
  <arg name="map"            default=""           description="Map name (required for sim, and for virtual:=true)"/>
  <let name="config_dir" value="$(find-pkg-share stack_master)/config/SIM" if="$(var sim)"/>
  <let name="config_dir" value="$(find-pkg-share stack_master)/config/CAR" unless="$(var sim)"/>
  <arg name="vehicle_config" default="$(var config_dir)/vehicle_config.yaml"/>
  <arg name="use_estop"      default="false"               description="Use emergency stop (true) or not (false)"/>

  <!-- ===== VESC current-control toggle (vesc_current_control) =====
       false = 기존 속도(eRPM) 제어: ackermann_to_vesc → /commands/motor/speed.
       true  = 속도 PID → 모터 전류: speed_pid_to_current → /commands/motor/current
               (+ 회생 위해 vesc_driver current_min override). gain/servo 는
               vehicle_config 의 vesc/** 와일드카드에서 자동 수급, PID 전용값만 아래 인자로. -->
  <arg name="use_current_control" default="false" description="true=속도 PID→전류, false=기존 속도(eRPM)"/>
  <arg name="cc_kp"                default="12.0"  description="PID P 게인 (kp≈cc_current_max/가속구간오차; 실차 튜닝)"/>
  <arg name="cc_vel_ff_gain"       default="0.0"   description="속도 FF[A/(m/s)] (0=off). 감사2026-08-06: 이 차 항력은 관성의 1/51 → 실익 적음. 켜면 cc_ki 를 낮출 것"/>
  <arg name="cc_static_ff"         default="0.0"   description="정지마찰 FF[A] — breakaway(0=off)"/>
  <arg name="cc_accel_ff_gain"     default="0.0"   description="가속 FF[A/(m/s^2)] — 사용금지, 0 유지. 목표의 인과적 미분이라 preview 없고 실측상 느려짐(docs/USAGE.md)"/>
  <arg name="cc_ki"                default="6.0"   description="PID I 게인"/>
  <arg name="cc_kd"                default="0.0"   description="PID D 게인"/>
  <arg name="cc_current_max"       default="30.0"  description="PID 출력 전류 상한[A] (레이스시 상향)"/>
  <arg name="cc_current_min"       default="-20.0" description="PID 출력 전류 하한[A] (음수=회생)"/>
  <arg name="cc_driver_current_min" default="-55.0" description="vesc_driver current_min override(회생, 펌웨어 -60 안쪽)"/>
  <arg name="cc_driver_current_max" default="90.0"  description="vesc_driver current_max override"/>
  <arg name="cc_speed_sign"        default="1.0"   description="속도피드백 부호(이 차 미검증 → 벤치 확인)"/>
  <arg name="cc_current_sign"      default="1.0"   description="전류부호↔진행방향(결선 의존)"/>
  <arg name="cc_max_abs_speed"     default="12.0"  description="폭주 가드[m/s] (레이스 최고속 위)"/>
  <!-- virtual_perception (scan_overlay + virtual opponent + static obstacles).
       Defaults ON in sim (preserves prior behavior), OFF on the real car; toggle
       with virtual:=true (e.g. to overlay a virtual opponent onto the real LiDAR). -->
  <arg name="virtual"        default="$(var sim)"          description="Inject virtual opponent/obstacles into the perception stack"/>

  <!-- map paths (needed by the simulator and by virtual_perception in both sim and real) -->
  <let name="maps_dir" value="$(find-pkg-share stack_master)/maps"/>
  <let name="map_path" value="$(var maps_dir)/$(var map)/$(var map)"/>

  <!-- ========== REAL HARDWARE SENSORS ========== -->
  <group unless="$(var sim)">
    <!-- VESC: motor driver + ackermann converter + wheel odometry (/vesc/odom) -->
    <group>
      <push_ros_namespace namespace="vesc"/>

      <!-- vesc_driver — 속도모드(기존): vehicle_config 그대로(current_min=0) -->
      <node pkg="vesc_driver" exec="vesc_driver_node" name="vesc_driver_node" output="screen"
            unless="$(var use_current_control)">
        <param from="$(var vehicle_config)"/>
      </node>
      <!-- vesc_driver — 전류모드: 회생 위해 current_min/max override -->
      <node pkg="vesc_driver" exec="vesc_driver_node" name="vesc_driver_node" output="screen"
            if="$(var use_current_control)">
        <param from="$(var vehicle_config)"/>
        <param name="current_min" value="$(var cc_driver_current_min)"/>
        <param name="current_max" value="$(var cc_driver_current_max)"/>
      </node>

      <!-- 변환단 A(기존): ackermann_to_vesc — 속도 → eRPM -->
      <include file="$(find-pkg-share vesc_ackermann)/launch/ackermann_to_vesc_node.launch.xml"
               unless="$(var use_current_control)">
        <arg name="vesc_config" value="$(var vehicle_config)"/>
      </include>
      <!-- 변환단 B: speed_pid_to_current — 속도 PID → 전류 (+servo 변환 흡수).
           /vesc 네임스페이스 안이라 루트 토픽(commands/motor/current, sensors/core,
           ackermann_cmd)이 /vesc/... 로 자동 매핑 → remap 불필요.
           gain(4614)·servo 게인은 vesc/** 와일드카드에서, PID 전용값은 아래에서 override. -->
      <node pkg="vesc_current_control" exec="speed_pid_to_current" name="speed_pid_to_current_node"
            output="screen" if="$(var use_current_control)">
        <param from="$(var vehicle_config)"/>
        <param name="kp"            value="$(var cc_kp)"/>
        <param name="ki"            value="$(var cc_ki)"/>
        <param name="kd"            value="$(var cc_kd)"/>
        <param name="vel_ff_gain"   value="$(var cc_vel_ff_gain)"/>
        <param name="static_ff"     value="$(var cc_static_ff)"/>
        <param name="accel_ff_gain" value="$(var cc_accel_ff_gain)"/>
        <param name="current_max"   value="$(var cc_current_max)"/>
        <param name="current_min"   value="$(var cc_current_min)"/>
        <param name="speed_sign"    value="$(var cc_speed_sign)"/>
        <param name="current_sign"  value="$(var cc_current_sign)"/>
        <param name="max_abs_speed" value="$(var cc_max_abs_speed)"/>
      </node>

      <!-- 휠 오도메트리: 항상 -->
      <include file="$(find-pkg-share vesc_ackermann)/launch/vesc_to_odom_node.launch.xml">
        <arg name="vesc_config" value="$(var vehicle_config)"/>
      </include>
    </group>

    <!-- LiDAR: publishes /scan (frame_id: laser). With virtual:=true the raw scan goes
         to /scan_raw so scan_overlay (virtual_perception) can own /scan; otherwise the
         identity remap leaves it on /scan. -->
    <let name="lidar_scan_out" value="/scan_raw" if="$(var virtual)"/>
    <let name="lidar_scan_out" value="/scan"     unless="$(var virtual)"/>
    <node pkg="urg_node" exec="urg_node_driver" name="urg_node" output="screen">
      <param from="$(var vehicle_config)"/>
      <remap from="/scan" to="$(var lidar_scan_out)"/>
    </node>

    <!-- Static TFs (base_link->laser, IMU frames) now come from per-vehicle config
         so they can differ by SIM/CAR — edit config/CAR/static_transforms.yaml,
         no launch change needed. config_dir is CAR here (this is the unless-sim
         group); in sim base_link->laser comes from the gym URDF and there is no IMU. -->
    <node pkg="stack_master" exec="static_tf_publisher.py" name="static_tf_publisher" output="screen">
      <param from="$(var config_dir)/static_transforms.yaml"/>
    </node>

  </group>

  <!-- ========== SIMULATOR ========== -->
  <!-- gym_bridge: virtual /scan + odometry, optional TF -->
  <group if="$(var sim)">
    <!-- ego scan -> /scan_raw when the virtual overlay owns /scan, else straight to /scan -->
    <let name="gym_scan_out" value="/scan_raw" if="$(var virtual)"/>
    <let name="gym_scan_out" value="/scan"     unless="$(var virtual)"/>
    <include file="$(find-pkg-share f1tenth_gym_ros)/launch/gym_bridge_launch.py">
      <arg name="map_yaml_path" value="$(var map_path).yaml"/>
      <arg name="ego_scan_out"  value="$(var gym_scan_out)"/>
    </include>
  </group>

  <!-- ========== VIRTUAL PERCEPTION (sim + real) ==========
       The SAME package for both: base scan comes in on /scan_raw (gym or urg),
       scan_overlay owns /scan, and the virtual opponent + static obstacles +
       tracking_merger run. Gated by `virtual`; when off, the sensor owns /scan
       directly and none of these nodes start. -->
  <group if="$(var virtual)">
    <include file="$(find-pkg-share virtual_perception)/launch/virtual_perception.launch.xml">
      <arg name="map_path"       value="$(var map_path).yaml"/>
      <arg name="ego_odom_topic" value="/car_state/odom"/>
      <arg name="scan_in"        value="/scan_raw"/>
      <arg name="scan_out"       value="/scan"/>
    </include>
  </group>

  <!-- ========== KEYBOARD TELEOP SOURCE (sim only) ========== -->
  <!-- keyboard_joy (pynput -> /joy_keyboard). pynput needs a focused keyboard +
       display, so only start it in sim (single machine); it always runs here so the
       pitwall panel can switch the mux to keyboard at runtime. On the real (headless)
       car, run keyboard_joy_node on the operator laptop instead. The mux starts on joy
       and only honours /joy_keyboard once the panel flips /ego/use_keyboard. -->
  <node pkg="stack_master" exec="keyboard_joy_node.py" name="keyboard_joy" output="screen"
        if="$(var sim)"/>

  <!-- Joystick / Command mux -->
  <node pkg="stack_master" exec="simple_mux_node.py" name="simple_mux" output="log">
    <param from="$(var vehicle_config)"/>
    <param name="in_topic"      value="/vesc/high_level/ackermann_cmd"/>
    <param name="out_topic"     value="/vesc/ackermann_cmd"/>
    <param name="joy_max_speed" value="4.0"/>
    <param name="use_estop" value="$(var use_estop)"/>
    <param name="sim" value="$(var sim)"/>
    <!-- use_keyboard defaults False (joy); the pitwall panel flips it at runtime via
         /ego/use_keyboard. keyboard_joy still publishes /joy_keyboard in sim regardless. -->
  </node>

</launch>
